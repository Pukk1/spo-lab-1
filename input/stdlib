function read_num() as int
    dim in as int
    dim res as int
    dim i as int
    res = 0;
    i = 1;
    while true
        in = stdin();
        if in == 13 then
            stdin();
            break
        end if
        res = res * 10 + (in - 48);
        i = i + 1;
    wend
    res;
end function

function number_length(num as int) as int
    dim rest as int
    dim count as int
    count = 1;
    rest = num/10;
    while rest != 0
        rest = rest/10;
        count = count + 1;
    wend
    count;
end function

